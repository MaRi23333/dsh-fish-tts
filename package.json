{
  "name": "dsh-plugin-fish-tts",
  "version": "0.2.2",
  "description": "Fish Audio TTS plugin for DeepSeek Harness: per-message read-aloud, auto-read toggle in the composer, and a settings page for model / voice / encrypted API key / proxy.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "tts",
    "fish-audio",
    "text-to-speech"
  ],
  "type": "module",
  "main": "lib/index.js",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaRi23333/dsh-plugin-fish-tts.git"
  },
  "homepage": "https://github.com/MaRi23333/dsh-plugin-fish-tts#readme",
  "bugs": {
    "url": "https://github.com/MaRi23333/dsh-plugin-fish-tts/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/security.test.ts tests/store.test.ts tests/clean.test.ts",
    "smoke": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "undici": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
